# Copie este arquivo para backend/.env (uso local) ou cadastre estas
# variáveis no painel do servidor (Coolify, Render, etc.).

PORT=3000

# Banco Postgres
# Deixe comentado para usar o banco embutido (nada para instalar no PC).
# Preencha só se quiser usar um Postgres seu ou no servidor de deploy.
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=infohub
# DB_USER=infohub
# DB_PASSWORD=infohub123
# DB_SCHEMA=nome_do_schema_da_dupla   (padrão: public)
# DB_SSL=false                        (true se o banco exigir SSL)

# No servidor de deploy é OBRIGATÓRIA (mínimo 32 caracteres).
# No PC, com "npm start", é gerada automaticamente se faltar.
AUTH_SECRET=troque-isto-por-um-texto-aleatorio-com-32-ou-mais-caracteres

# Endereço público do sistema (usado nos links dos e-mails)
APP_URL=http://localhost:3000

# Pasta dos arquivos enviados pelos alunos (no Docker, monte um volume aqui)
# UPLOAD_DIR=/app/uploads

# E-mail (opcional; sem isso o sistema sobe, só não envia convites)
# SMTP_PROVIDER=gmail
# SMTP_USER=
# SMTP_PASS=
# MAIL_FROM=
